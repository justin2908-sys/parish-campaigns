# Copy to .env for local dev (Netlify CLI reads it) — never commit the real .env.
# In production these are set as Netlify site environment variables instead.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard -> Project Settings -> API -> service_role secret (NOT the anon/publishable key)
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string — used to sign session tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SumUp developer portal — leave blank until the SumUp API integration is wired in.
# Cash and Card-manual logging both work fully without these (see docs/scope-v1.0.md §4.4).
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
